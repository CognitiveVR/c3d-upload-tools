// cSpell Settings
{
    // Version of the setting file.  Always 0.2
    "version": "0.2",
    // language - current active spelling language
    "language": "en,en-GB",
    // words - list of words to be always considered correct
    "words": [
        "APIKEY",
        "certutil",
        "cobra",
        "cognitivevr",
        "ddev",
        "dependabot",
        "fakegateway",
        "globoff",
        "gltf",
        "gofmt",
        "golangci",
        "goreleaser",
        "gopkg",
        "govulncheck",
        "hashfile",
        "httptest",
        "localfile",
        "Nopper",
        "notarytool",
        "Pavlovic",
        "pflag",
        "testdata",
        "virtualenv",
        "visualstudio",
        "xcrun"
    ],
    "ignorePaths": [
        "node_modules/**",
        ".superpowers/**",
        ".planning/**",
        ".claude/**",
        ".companion-state/**"
    ],
    // flagWords - list of words to be always considered incorrect
    // This is useful for offensive words and common spelling errors.
    // For example "hte" should be "the"
    "flagWords": [
        "hte"
    ]
}
